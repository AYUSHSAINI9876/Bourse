# Google style with a wider column limit -- 80 columns forces awkward wrapping
# on the template-heavy signatures in core/ without improving readability.
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 110
IndentWidth: 2
AccessModifierOffset: -1
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
# Enum-to-string lookup tables read as tables when each case is one line, and
# as noise when Google style splits them across two. There are ~95 of them
# here, all deliberate, so the config describes the style the code actually
# uses rather than fighting it.
AllowShortCaseLabelsOnASingleLine: true
AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: true
BinPackParameters: true
SeparateDefinitionBlocks: Always
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<gtest/'
    Priority: 1
  - Regex: '^<.*\.h>'
    Priority: 2
  - Regex: '^<.*>'
    Priority: 3
  - Regex: '^"bourse/'
    Priority: 4
  - Regex: '.*'
    Priority: 5
