{
  // ---------------------------------------------------------------------
  // IntelliSense
  //
  // compile_commands.json is generated by CMake (CMAKE_EXPORT_COMPILE_COMMANDS
  // is ON in CMakeLists.txt). Pointing the C++ extension at it means
  // IntelliSense uses the *real* compiler flags -- the same -std=c++20,
  // include paths and BOURSE_HAVE_EPOLL define the build uses -- instead of
  // guessing. Without this, every <bourse/...> include shows a red squiggle.
  //
  // Note: the paths inside it are WSL paths (/mnt/c/...), so this only
  // resolves correctly when the folder is opened *in WSL*. See README.
  // ---------------------------------------------------------------------
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++20",
  "C_Cpp.default.compilerPath": "/usr/bin/g++",
  "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",

  "cmake.buildDirectory": "${workspaceFolder}/build",
  "cmake.generator": "Ninja",
  "cmake.configureOnOpen": false,
  "cmake.configureArgs": ["-DBOURSE_BUILD_TESTS=ON"],

  // ---------------------------------------------------------------------
  // Formatting
  // ---------------------------------------------------------------------
  "editor.formatOnSave": true,
  "editor.rulers": [110],
  "C_Cpp.clang_format_style": "file",
  "[cpp]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
  "[c]": { "editor.defaultFormatter": "ms-vscode.cpptools" },

  // Shell scripts must stay LF or they break in WSL and Docker.
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "files.associations": {
    "*.hpp": "cpp",
    "*.tpp": "cpp"
  },

  // Build output is noise in search and the file tree.
  "files.exclude": {
    "**/build": true,
    "**/build-*": true,
    "**/bourse-data": true
  },
  "search.exclude": {
    "**/build": true,
    "**/build-*": true
  },

  "terminal.integrated.defaultProfile.linux": "bash"
}
